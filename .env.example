# Copy this file to .env and fill in the platforms you want to use.
# A platform whose required values are empty is skipped automatically.

# ---------------------------------------------------------------- general
TIMEZONE=Asia/Kolkata
LOG_LEVEL=INFO
LOG_FILE=logs/posting.log
# Each run's JSON result is also saved here
RUNS_DIR=logs/runs
REQUEST_TIMEOUT=15
MAX_RETRIES=1
# Open each posted URL without credentials to confirm it is public
VERIFY_PUBLIC_ACCESS=true
# Optional: comma-separated keys to limit posting, e.g. devto,telegram
# Keys: bluesky, devto, github_gist, huggingface, telegram, telegraph, writeas
ENABLED_PLATFORMS=

# ---------------------------------------------------------------- Telegraph (no account needed)
# Leave empty and a token is created on first use. Set it to keep pages under one account.
TELEGRAPH_ACCESS_TOKEN=
TELEGRAPH_AUTHOR_NAME=Automated Posting

# ---------------------------------------------------------------- Write.as (no account needed)
# Leave empty to publish anonymously.
WRITEAS_ACCESS_TOKEN=

# ---------------------------------------------------------------- GitHub Gist
# https://github.com/settings/tokens/new?scopes=gist
GITHUB_TOKEN=

# ---------------------------------------------------------------- Dev.to
# https://dev.to/settings/extensions -> DEV Community API Keys
DEVTO_API_KEY=
DEVTO_TAGS=python,fastapi,automation

# ---------------------------------------------------------------- Hugging Face
# https://huggingface.co/settings/tokens (token type: Write)
HF_TOKEN=
# Repo that hosts the discussions. Created automatically if missing.
# Default: <your-username>/automated-posting-feed
HF_REPO_ID=
HF_REPO_TYPE=dataset

# ---------------------------------------------------------------- Bluesky
# Handle (yourname.bsky.social) and an app password from
# Settings > Privacy and security > App passwords
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
BLUESKY_SERVICE=https://bsky.social

# ---------------------------------------------------------------- Telegram
# Bot token from @BotFather. Add the bot as an admin of your channel.
TELEGRAM_BOT_TOKEN=
# Public channel username (@my_channel) or numeric chat id
TELEGRAM_CHAT_ID=
